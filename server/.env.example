# Server
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# Set to false to skip auto-seeding the demo business on a fresh (user-less) database
SEED_DEMO=true

# --- Database ---------------------------------------------------------------
# Default: SQLite file (no config needed)
DB_CLIENT=sqlite
SQLITE_FILE=./data/xpos.sqlite

# Postgres (Neon / Render / local): setting DATABASE_URL alone switches to Postgres
# (or set DB_CLIENT=pg). TLS is on by default; DATABASE_SSL=false for a local server.
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
# DATABASE_SSL=false
# DB_POOL_MAX=5

# MySQL (used when DB_CLIENT=mysql2)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=xpos
DB_PASSWORD=secret
DB_NAME=xpos
